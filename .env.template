# Vector UI configuration. Copy to .env for local development; on Vercel set the same names under
# Project Settings > Environment Variables (they are read at build time).

# --- required ---------------------------------------------------------------------------------------------
# openBalena API the browser talks to for fleets, devices and releases. Must allow this UI's origin (CORS).
REACT_APP_OPEN_BALENA_API_URL=https://api.my-open-balena-server.com
# Version of that API, used to choose compatible resource names. See docs/api-versions.md.
REACT_APP_OPEN_BALENA_API_VERSION=v52.2.3

# --- Vector server ------------------------------------------------------------------------------------------
# Public URL of the Vector server (repository vector-balena, src/vector-server). Leave empty for local
# development: the dev server forwards its routes to VECTOR_SERVER_DEV_URL. It must be https when the UI is
# served over https, and its VECTOR_ALLOWED_ORIGINS must include this UI's origin.
REACT_APP_VECTOR_SERVER_URL=
# Local development only: where `npm run dev` forwards server routes.
VECTOR_SERVER_DEV_URL=http://127.0.0.1:3001

# --- optional ------------------------------------------------------------------------------------------------
# Force a specific OData version (v6 or v7) instead of deriving it from the API version.
REACT_APP_OPEN_BALENA_ODATA_VERSION=
# Custom banner image URL for the sign-in page.
REACT_APP_BANNER_IMAGE=
# Set to false to hide the built-in terminal and file transfer (served by the Vector server).
REACT_APP_OPEN_BALENA_BUILT_IN_REMOTE_ENABLED=true
# Use the older open-balena-remote service instead of the built-in one. Leave empty to use the built-in one.
REACT_APP_OPEN_BALENA_REMOTE_URL=

# Local development port.
PORT=3000

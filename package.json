{
  "name": "vector-ui",
  "version": "0.9.4",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.104.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "assert": "^2.1.0",
    "axios": "^1.12.2",
    "bcrypt-ts": "^7.1.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "core-js": "^3.46.0",
    "dateformat": "^5.0.3",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "final-form": "^5.0.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.70.0",
    "micro-key-producer": "^0.8.2",
    "motion": "^14.10.1",
    "process": "^0.11.10",
    "prop-types": "^15.8.1",
    "query-string": "^7.1.3",
    "ra-core": "5.15.3",
    "react": "^19.2.3",
    "react-admin": "5.15.3",
    "react-dom": "^19.2.3",
    "react-final-form": "^7.0.0",
    "react-hook-form": "^7.65.0",
    "react-password-checklist": "^1.8.1",
    "react-router": "^7.9.5",
    "react-router-dom": "^7.9.5",
    "regenerator-runtime": "^0.14.1",
    "semver": "^7.7.3",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/dateformat": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/query-string": "^6.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.2.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "scripts": {
    "dev": "vite --mode devprod --host 0.0.0.0",
    "dev:local": "vite --mode local",
    "build": "vite build",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/authProvider/*.test.ts src/components/*.test.ts src/dataProvider/*.test.ts src/lib/*.test.ts src/vector/docs/*.test.ts src/vector/lib/*.test.ts src/versions/*.test.ts test/*.test.ts",
    "prettier": "prettier --write ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    }
  },
  "description": "Vector UI: static single-page admin app for Protoform Vector. Needs the Vector server (vector-balena repo) and an openBalena API."
}
